@model FloristeriaWeb.Models.Orden

@{
    ViewData["Title"] = "Detalle del Pedido #" + Model.Id;
    var detalles = ViewBag.Detalles as IEnumerable<FloristeriaWeb.Models.DetalleOrden>;
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Pedido #@Model.Id</h2>
            <p class="text-muted mb-0">Realizado el @Model.FechaOrden.ToString("dd/MM/yyyy") a las @Model.FechaOrden.ToString("hh:mm tt")</p>
        </div>
        <a asp-action="MisPedidos" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Volver a mis pedidos
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-flower1 me-2"></i>Productos en el Pedido</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Flor / Arreglo</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Precio Unitario</th>
                                    <th class="text-end pe-4">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in detalles)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.Flor.ImagenUrl))
                                                {
                                                    <img src="@item.Flor.ImagenUrl" alt="@item.Flor.Nombre" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                                }
                                                <div>
                                                    <span class="fw-bold d-block">@item.Flor.Nombre</span>
                                                    <span class="text-muted small">Código: #@item.FlorId</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Cantidad</td>
                                        <td class="text-end">C$ @item.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end fw-bold pe-4">C$ @((item.Cantidad * item.PrecioUnitario).ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white p-4 border-0 text-end">
                    <span class="text-muted me-2 fs-5">Total Pagado:</span>
                    <strong class="text-success fs-3">C$ @Model.Total.ToString("N2")</strong>
                </div>
            </div>

            <div class="card shadow border-0">
                <div class="card-body bg-light d-flex align-items-center justify-content-between p-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-paypal text-primary fs-2 me-3"></i>
                        <div>
                            <span class="text-secondary small d-block">ID de Transacción de PayPal</span>
                            <code class="text-dark fw-bold fs-6">@Model.TransactionId</code>
                        </div>
                    </div>
                    <span class="badge bg-success p-2"><i class="bi bi-shield-check"></i> Pago Verificado</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow border-0 text-center p-4 mb-4">
                <span class="text-muted small text-uppercase d-block mb-2">Estado del Envío</span>

                @switch (Model.EstadoPagoId)
                {
                    case 1:
                        <div class="alert alert-warning m-0 py-3"><i class="bi bi-clock-history fs-4 d-block mb-1"></i> <strong>Pendiente</strong></div>
                        break;
                    case 2:
                        <div class="alert alert-info m-0 py-3"><i class="bi bi-flower1 fs-4 d-block mb-1"></i> <strong>En Preparación</strong></div>
                        break;
                    case 3:
                        <div class="alert alert-primary m-0 py-3"><i class="bi bi-truck fs-4 d-block mb-1"></i> <strong>En Camino</strong></div>
                        break;
                    case 4:
                        <div class="alert alert-success m-0 py-3"><i class="bi bi-check-circle-fill fs-4 d-block mb-1"></i> <strong>Entregado</strong></div>
                        break;
                    default:
                        <div class="alert alert-secondary m-0 py-3"><strong>@Model.Estado</strong></div>
                        break;
                }
            </div>

            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Información de Entrega</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <span class="text-muted small d-block">Destinatario:</span>
                        <strong class="text-dark">@Model.NombreDestinatario @Model.ApellidoDestinatario</strong>
                    </div>
                    <div class="mb-3">
                        <span class="text-muted small d-block">Teléfono de contacto:</span>
                        <strong class="text-dark"><i class="bi bi-telephone small me-1"></i> @Model.Telefono</strong>
                    </div>
                    <div class="mb-3">
                        <span class="text-muted small d-block">Ubicación:</span>
                        <strong class="text-dark">@Model.Municipio.Nombre, @Model.Municipio.Departamento.Nombre</strong>
                    </div>
                    <div class="mb-0">
                        <span class="text-muted small d-block">Dirección Exacta:</span>
                        <p class="text-dark mb-0 bg-light p-2 rounded small border text-justify">@Model.Direccion</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>