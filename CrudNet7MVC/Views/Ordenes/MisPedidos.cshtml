@model IEnumerable<FloristeriaWeb.Models.Orden>

@{
    ViewData["Title"] = "Mis Pedidos";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-seam me-2"></i>Historial de mis Pedidos</h2>
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left"></i> Continuar Comprando
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow border-0 text-center p-5">
            <div class="card-body">
                <div class="text-muted display-1 mb-3">
                    <i class="bi bi-cart-x"></i>
                </div>
                <h4>¿Aún no has realizado ninguna compra?</h4>
                <p class="text-muted">Explora nuestro catálogo y sorprende a alguien especial con nuestros arreglos florales.</p>
                <a asp-action="Index" asp-controller="Home" class="btn btn-dark mt-3">Ver Flores Disponibles</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">Fecha</th>
                                <th>Destinatario</th>
                                <th>Destino</th>
                                <th>Total</th>
                                <th>Estado del Envío</th>
                                <th class="text-center pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pedido in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <strong class="d-block">@pedido.FechaOrden.ToString("dd/MM/yyyy")</strong>
                                        <span class="text-muted small">@pedido.FechaOrden.ToString("hh:mm tt")</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold">@pedido.NombreDestinatario @pedido.ApellidoDestinatario</span>
                                        <span class="d-block text-muted small"><i class="bi bi-telephone"></i> @pedido.Telefono</span>
                                    </td>
                                    <td>
                                        @pedido.Municipio.Nombre, @pedido.Municipio.Departamento.Nombre
                                    </td>
                                    <td class="fw-bold text-success">
                                        C$ @pedido.Total.ToString("N2")
                                    </td>
                                    <td>
                                        @* Renderizado dinámico de insignias según el estado del pedido *@
                                        @switch (pedido.EstadoPagoId)
                                        {
                                            case 1:
                                                <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i> Pendiente</span>
                                                break;
                                            case 2:
                                                <span class="badge bg-info text-dark"><i class="bi bi-flower1 me-1"></i> En Preparación</span>
                                                break;
                                            case 3:
                                                <span class="badge bg-primary"><i class="bi bi-truck me-1"></i> En Camino</span>
                                                break;
                                            case 4:
                                                <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i> Entregado</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@pedido.Estado</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <a asp-action="DetallePedido" asp-route-id="@pedido.Id" class="btn btn-sm btn-outline-secondary" title="Ver Detalles del Pedido">
                                            <i class="bi bi-eye-fill"></i> Detalles
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>