@model List<FloristeriaWeb.Models.ElementoCarrito>

@{
    ViewData["Title"] = "Tu Carrito de Compras";
}

<div class="container mt-4">
    <h2><i class="bi bi-cart3"></i> @ViewData["Title"]</h2>
    <hr />

    @if (Model.Count > 0)
    {
        <div class="row">
            <div class="col-md-8">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Precio</th>
                            <th>Cantidad</th>
                            <th>Importe</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@item.ImagenUrl" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                        <span>@item.Nombre</span>
                                    </div>
                                </td>
                                <td>C$ @item.Precio.ToString("N2")</td>
                                <td>@item.Cantidad</td>
                                <td class="fw-bold">C$ @item.Importe.ToString("N2")</td>
                                <td>
                                    <a asp-action="Eliminar" asp-route-id="@item.FlorId" class="text-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Resumen del Pago -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Resumen de Compra</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>C$ @ViewBag.TotalCarrito.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 fs-4 fw-bold text-success">
                            <span>Total:</span>
                            <span>C$ @ViewBag.TotalCarrito.ToString("N2")</span>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-controller="Ordenes" asp-action="Checkout" class="btn btn-success btn-lg">
                                <i class="bi bi-credit-card"></i> Finalizar Compra
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-link text-muted">
                                Seguir comprando
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <h3 class="mt-3">Tu carrito está vacío</h3>
            <p class="text-muted">Parece que aún no has elegido flores para esa persona especial.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg mt-3">Ver Flores</a>
        </div>
    }
</div>